<config>
    <input>
        <jar in="build/libs/AegisAuth-1.0.1.jar" out="build/libs/AegisAuth-1.0.1-obfuscated.jar"/>
    </input>

    <keep-names>
        <!-- Bao ve lop Main plugin -->
        <class template="public class com.authsystem.plugin.AuthPlugin">
            <method template="public void onEnable()"/>
            <method template="public void onDisable()"/>
            <method template="public void onLoad()"/>
        </class>

        <!-- Bao ve cac lop Command Executor -->
        <class template="public class * implements org.bukkit.command.CommandExecutor">
            <method template="public boolean onCommand(org.bukkit.command.CommandSender, org.bukkit.command.Command, java.lang.String, java.lang.String[])"/>
        </class>

        <!-- Bao ve cac lop Tab Completer -->
        <class template="public class * implements org.bukkit.command.TabCompleter">
            <method template="public java.util.List onTabComplete(org.bukkit.command.CommandSender, org.bukkit.command.Command, java.lang.String, java.lang.String[])"/>
        </class>

        <!-- Bao ve cac lop Event Listener -->
        <class template="public class * implements org.bukkit.event.Listener">
            <method template="public void *(**)"/>
        </class>
    </keep-names>

    <!-- Thiet lap ma hoa chuoi va luong Allatori -->
    <property name="string-encryption" value="enable"/>
    <property name="string-encryption-type" value="fast"/>
    <property name="control-flow-obfuscation" value="enable"/>
    <property name="extensive-flow-obfuscation" value="normal"/>
    <property name="line-numbers" value="remove"/>
    <property name="inner-classes" value="remove"/>
</config>
